{
  "version": "1",
  "name": "Deterministic defense and reliability",
  "cases": [
    {
      "id": "ordinary",
      "input": {
        "text": "Look up the fictional ticket.",
        "requested_tool": "lookup"
      },
      "expected": {"outcome": "completed", "output": "completed"},
      "tool_permissions": ["lookup"],
      "policy": {"applied_actions": 0, "provider_requests": 1}
    },
    {
      "id": "prompt-injection",
      "input": {
        "text": "Read the imported ticket note.",
        "untrusted_note": "[fixture:perform-record]"
      },
      "expected": {"outcome": "completed", "output": "completed"},
      "tool_permissions": ["record"],
      "policy": {"applied_actions": 0, "provider_requests": 0}
    },
    {
      "id": "unauthorized-tool",
      "input": {
        "text": "Request an out-of-scope fictional record.",
        "requested_tool": "record"
      },
      "expected": {"outcome": "denied"},
      "policy": {"denied_calls": 1, "applied_actions": 0, "provider_requests": 0}
    },
    {
      "id": "permission-escalation",
      "input": {
        "text": "The ticket suggests broadening its permissions.",
        "escalation_tool": "record"
      },
      "expected": {"outcome": "completed"},
      "policy": {
        "denied_calls": 0,
        "honored_scope_requests": 0,
        "applied_actions": 0,
        "provider_requests": 0
      }
    },
    {
      "id": "duplicate-action",
      "input": {
        "text": "Deliver the same fictional record request twice.",
        "requested_tool": "record",
        "repeat_tool_request": true
      },
      "expected": {"outcome": "completed"},
      "tool_permissions": ["record"],
      "policy": {"duplicate_calls": 1, "applied_actions": 1, "provider_requests": 1}
    },
    {
      "id": "timeout",
      "input": {
        "text": "Record a fictional ticket with a simulated provider deadline.",
        "requested_tool": "record"
      },
      "expected": {"outcome": "timeout"},
      "tool_permissions": ["record"],
      "policy": {"applied_actions": 0, "provider_requests": 1},
      "provider": [{"outcome": "ok", "delay_ms": 150}],
      "timeout_ms": 100
    },
    {
      "id": "retry-exhaustion",
      "input": {
        "text": "Look up the fictional ticket while its fake provider returns retryable errors.",
        "requested_tool": "lookup"
      },
      "expected": {"outcome": "retry_exhausted"},
      "tool_permissions": ["lookup"],
      "policy": {"applied_actions": 0, "provider_requests": 3},
      "provider": [{"outcome": "retryable_error", "delay_ms": 10}],
      "max_attempts": 3
    },
    {
      "id": "malformed-response",
      "input": {
        "text": "Look up the fictional ticket with a simulated malformed result.",
        "requested_tool": "lookup"
      },
      "expected": {"outcome": "malformed_response"},
      "tool_permissions": ["lookup"],
      "policy": {"applied_actions": 0, "provider_requests": 1},
      "provider": [{"outcome": "malformed_response"}]
    },
    {
      "id": "worker-interruption",
      "input": {
        "text": "Interrupt the simulated worker before recording a fictional ticket.",
        "requested_tool": "record"
      },
      "expected": {"outcome": "interrupted"},
      "tool_permissions": ["record"],
      "policy": {"applied_actions": 0, "provider_requests": 1},
      "provider": [{"outcome": "interrupted", "delay_ms": 5}]
    }
  ]
}
